@foreach (var p in panels)
{
    <section class="admin-panel" data-panel="@p.Id" aria-label="@p.Title">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">@p.Title</h2>
                <p class="admin-panel-desc">@p.Desc</p>
            </div>
            <span class="admin-tag admin-tag--sample">داده نمونه</span>
        </header>

        @if (p.Kind == "list" || p.Kind == "grid")
        {
            <div class="admin-toolbar">
                @if (!string.IsNullOrEmpty(p.Search))
                {
                    <div class="admin-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input type="search" placeholder="@p.Search" aria-label="@p.Search">
                    </div>
                }
                @if (!string.IsNullOrEmpty(p.Action))
                {
                    <button class="btn btn-ghost" type="button" disabled>
                        <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        <span>@p.Action</span>
                    </button>
                }
            </div>
        }

        @if (p.Kind == "list")
        {
            <div class="admin-list">
                @foreach (var r in p.Rows)
                {
                    <article class="admin-row">
                        <div class="admin-row-thumb">
                            @if (string.IsNullOrEmpty(p.Icon))
                            {
                                @r.T.Substring(0, 1)
                            }
                            else
                            {
                                <svg class="admin-ico" aria-hidden="true"><use href="#@p.Icon"></use></svg>
                            }
                        </div>
                        <div class="admin-row-body">
                            <h4>@r.T</h4>
                            @if (!string.IsNullOrEmpty(r.D))
                            {
                                <p>@r.D</p>
                            }
                            <div class="admin-row-meta">
                                @if (!string.IsNullOrEmpty(r.Tag))
                                {
                                    <span class="admin-tag @(string.IsNullOrEmpty(r.Cls) ? "" : "admin-tag--" + r.Cls)">@r.Tag</span>
                                }
                                @if (!string.IsNullOrEmpty(r.M))
                                {
                                    <span>@r.M</span>
                                }
                            </div>
                        </div>
                        <div class="admin-row-actions">
                            <button class="admin-row-btn" type="button" title="ویرایش (به‌زودی)" aria-label="ویرایش" disabled>
                                <svg class="admin-ico" aria-hidden="true"><use href="#ad-edit"></use></svg>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
        else if (p.Kind == "grid")
        {
            <div class="admin-media-grid">
                @foreach (var r in p.Rows)
                {
                    <figure class="admin-media-tile">
                        <div class="admin-media-thumb"><svg class="admin-ico" aria-hidden="true"><use href="#ad-image"></use></svg></div>
                        <figcaption><strong dir="ltr">@r.T</strong><small>@r.M</small></figcaption>
                    </figure>
                }
            </div>
        }
        else if (p.Kind == "table")
        {
            <div class="admin-table-wrap" tabindex="0" role="region" aria-label="@p.Title">
                <table class="admin-table">
                    <thead><tr><th scope="col">نقش</th><th scope="col">اخبار</th><th scope="col">دیدگاه‌ها</th><th scope="col">کاربران</th></tr></thead>
                    <tbody>
                        @foreach (var r in p.Rows)
                        {
                            <tr><th scope="row">@r.T</th><td>@r.D</td><td>@r.Tag</td><td>@r.M</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (p.Kind == "bars")
        {
            <div class="admin-card glass-strong">
                <div class="admin-bars" role="img" aria-label="نمودار نمونه بازدید روزانه">
                    @foreach (var r in p.Rows)
                    {
                        <div class="admin-bar"><span class="admin-bar-val">@r.D</span><span class="admin-bar-fill" style="--h:@(r.M)%"></span><span class="admin-bar-label">@r.T</span></div>
                    }
                </div>
            </div>
        }
        else if (p.Kind == "toggles")
        {
            <div class="admin-cards admin-cards--single">
                <div class="admin-card glass-strong admin-card--wide">
                    @foreach (var r in p.Rows)
                    {
                        <div class="profile-pref">
                            <div>
                                <p class="profile-pref-name">@r.T</p>
                                @if (!string.IsNullOrEmpty(r.D))
                                {
                                    <p class="profile-pref-desc">@r.D</p>
                                }
                            </div>
                            <label class="profile-switch">
                                <input type="checkbox" aria-label="@r.T" checked="@(r.Tag == "1")"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
        else if (p.Kind == "empty")
        {
            <div class="admin-empty">
                <div class="admin-empty-icon"><svg class="admin-ico" aria-hidden="true"><use href="#@p.Icon"></use></svg></div>
                <h3>@p.EmptyTitle</h3>
                <p>@p.EmptyText</p>
                @if (!string.IsNullOrEmpty(p.Action))
                {
                    <button class="btn btn-ghost admin-empty-btn" type="button" disabled><span>@p.Action</span></button>
                }
            </div>
        }

        <p class="profile-hint profile-hint--block admin-hint-block">بک‌اند این بخش بعداً اضافه می‌شود. در حال حاضر فقط رابط کاربری آماده است.</p>
    </section>
}
