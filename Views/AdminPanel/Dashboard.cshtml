@{
    Layout = "_Layout";
    ViewData["Title"] = "پنل مدیریت | کافینت آریا";
}

<div class="admin-zone">
    <canvas class="starfield-canvas" data-count="20" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>

    <!-- Header -->
    <section class="admin-hero">
        <div class="container admin-hero-inner">
            <div>
                <p class="eyebrow on-dark">پنل مدیریت</p>
                <h1 class="admin-hero-title">کافینت آریا — کنترل مرکزی</h1>
                <p class="admin-hero-sub">از اینجا می‌توانید اخبار، دیدگاه‌ها و سایر بخش‌های سایت را مدیریت کنید.</p>
            </div>
            <div class="admin-hero-stats">
                <div class="admin-hero-stat">
                    <span class="admin-hero-stat-num" data-count="0">۰</span>
                    <span class="admin-hero-stat-label">خبر فعال</span>
                </div>
                <div class="admin-hero-stat">
                    <span class="admin-hero-stat-num" data-count="0">۰</span>
                    <span class="admin-hero-stat-label">دیدگاه</span>
                </div>
                <div class="admin-hero-stat">
                    <span class="admin-hero-stat-num" data-count="0">۰</span>
                    <span class="admin-hero-stat-label">کاربر</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Tab bar -->
    <section class="admin-tabs-wrap">
        <div class="container">
            <div class="admin-tabs" role="tablist" aria-label="بخش‌های مدیریت">
                <button class="admin-tab is-active" data-tab="news" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><line x1="3" y1="11" x2="21" y2="11" /></svg>
                    مدیریت اخبار
                </button>
                <button class="admin-tab" data-tab="comments" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5C21.0034 12.82 20.6951 14.12 20.1 15.3C19.3944 16.7118 18.3097 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0035 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92176 4.44061 8.37485 5.27072 7.03258C6.10083 5.69031 7.28825 4.6056 8.7 3.90003C9.87812 3.30496 11.1801 2.99659 12.5 3.00003H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" /></svg>
                    دیدگاه‌ها
                </button>
                <button class="admin-tab" data-tab="users" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    کاربران
                </button>
                <button class="admin-tab" data-tab="settings" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    تنظیمات
                </button>
            </div>
        </div>
    </section>

    <!-- Body -->
    <section class="admin-body">
        <div class="container">

            <!-- ===== NEWS MANAGEMENT ===== -->
            <section class="admin-panel is-active" data-panel="news">
                <div class="admin-toolbar">
                    <div class="admin-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input type="search" placeholder="جستجوی خبر...">
                    </div>
                    <button class="btn btn-solid" data-action="new-news">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        <span>افزودن خبر جدید</span>
                    </button>
                </div>

                <div class="admin-list" id="adminNewsList">
                    <!-- Sample news items (UI placeholders) -->
                    <article class="admin-row">
                        <div class="admin-row-thumb">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="2.5" x2="8" y2="6.5" /><line x1="16" y1="2.5" x2="16" y2="6.5" /></svg>
                        </div>
                        <div class="admin-row-body">
                            <h4>نمونه خبر اول</h4>
                            <p>این یک نمونه پیش‌نمایش خبر است که بعداً از بک‌اند بارگذاری می‌شود.</p>
                            <div class="admin-row-meta">
                                <span class="admin-tag admin-tag--ok">فعال</span>
                                <span>۱۴۰۴/۰۶/۱۲</span>
                                <span>۱۲ دیدگاه</span>
                            </div>
                        </div>
                        <div class="admin-row-actions">
                            <button class="admin-row-btn" title="ویرایش" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                            </button>
                            <button class="admin-row-btn admin-row-btn--danger" title="حذف" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6" /></svg>
                            </button>
                        </div>
                    </article>

                    <article class="admin-row">
                        <div class="admin-row-thumb">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="2.5" x2="8" y2="6.5" /><line x1="16" y1="2.5" x2="16" y2="6.5" /></svg>
                        </div>
                        <div class="admin-row-body">
                            <h4>نمونه خبر دوم</h4>
                            <p>پیش‌نمایش دومین خبر — بعد از اتصال به بک‌اند، لیست واقعی نمایش داده می‌شود.</p>
                            <div class="admin-row-meta">
                                <span class="admin-tag admin-tag--warn">پیش‌نویس</span>
                                <span>۱۴۰۴/۰۶/۰۸</span>
                                <span>۰ دیدگاه</span>
                            </div>
                        </div>
                        <div class="admin-row-actions">
                            <button class="admin-row-btn" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                            </button>
                            <button class="admin-row-btn admin-row-btn--danger" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6" /></svg>
                            </button>
                        </div>
                    </article>
                </div>

                <div class="admin-empty" id="adminNewsEmpty" hidden>
                    <div class="admin-empty-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><line x1="3" y1="11" x2="21" y2="11" /></svg>
                    </div>
                    <h3>هنوز خبری اضافه نشده</h3>
                    <p>با کلیک روی «افزودن خبر جدید» اولین خبر خود را بسازید.</p>
                </div>

                <p class="profile-hint profile-hint--block admin-hint-block">
                    بک‌اند این بخش بعداً اضافه می‌شود. در حال حاضر فقط رابط کاربری آماده است.
                </p>
            </section>

            <!-- ===== COMMENTS MANAGEMENT ===== -->
            <section class="admin-panel" data-panel="comments">
                <div class="admin-toolbar">
                    <div class="admin-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input type="search" placeholder="جستجو در دیدگاه‌ها...">
                    </div>
                    <div class="admin-filter-group">
                        <button class="is-active" type="button">همه</button>
                        <button type="button">در انتظار</button>
                        <button type="button">تأیید شده</button>
                        <button type="button">رد شده</button>
                    </div>
                </div>

                <div class="admin-list">
                    <article class="admin-row">
                        <div class="admin-row-thumb admin-row-thumb--avatar">ع</div>
                        <div class="admin-row-body">
                            <h4>علی محمدی</h4>
                            <p>این یک نمونه دیدگاه است که از بک‌اند بارگذاری خواهد شد.</p>
                            <div class="admin-row-meta">
                                <span class="admin-tag admin-tag--ok">تأیید شده</span>
                                <span>روی: نمونه خبر اول</span>
                                <span>۱۴۰۴/۰۶/۱۲</span>
                            </div>
                        </div>
                        <div class="admin-row-actions">
                            <button class="admin-row-btn" title="پاسخ" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4" /><path d="M20 20v-7a4 4 0 0 0-4-4H4" /></svg>
                            </button>
                            <button class="admin-row-btn admin-row-btn--danger" title="حذف" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6" /></svg>
                            </button>
                        </div>
                    </article>
                </div>
            </section>

            <!-- ===== USERS ===== -->
            <section class="admin-panel" data-panel="users">
                <div class="admin-toolbar">
                    <div class="admin-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input type="search" placeholder="جستجوی کاربر...">
                    </div>
                    <button class="btn btn-ghost" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        <span>افزودن کاربر (به‌زودی)</span>
                    </button>
                </div>

                <div class="admin-list">
                    <article class="admin-row">
                        <div class="admin-row-thumb admin-row-thumb--avatar">پ</div>
                        <div class="admin-row-body">
                            <h4>پشتیبانی کافینت آریا</h4>
                            <p dir="ltr">ariacafeenet@gmail.com</p>
                            <div class="admin-row-meta">
                                <span class="admin-tag admin-tag--admin">مدیر</span>
                                <span dir="ltr">۰۹۹۲۳۳۶۵۳۷۳</span>
                            </div>
                        </div>
                        <div class="admin-row-actions">
                            <button class="admin-row-btn" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                            </button>
                        </div>
                    </article>
                </div>
            </section>

            <!-- ===== SETTINGS ===== -->
            <section class="admin-panel" data-panel="settings">
                <div class="admin-cards">
                    <div class="admin-card glass-strong">
                        <h3>تنظیمات عمومی سایت</h3>
                        <div class="admin-form-row">
                            <label>نام سایت</label>
                            <input type="text" class="profile-input" value="کافینت آریا">
                        </div>
                        <div class="admin-form-row">
                            <label>شعار</label>
                            <input type="text" class="profile-input" value="همیشه یک قدم جلوتر از شما">
                        </div>
                        <div class="admin-form-row">
                            <label>ایمیل پشتیبانی</label>
                            <input type="email" class="profile-input" dir="ltr" value="ariacafeenet@gmail.com">
                        </div>
                        <div class="admin-form-row">
                            <label>توضیحات سایت (SEO)</label>
                            <textarea class="profile-input profile-textarea" rows="3">ارائه انواع خدمات اینترنتی، ثبت نام، پرداخت قبوض و خدمات دانشجویی در بهبهان.</textarea>
                        </div>
                    </div>

                    <div class="admin-card glass-strong">
                        <h3>تنظیمات نظرات</h3>
                        <div class="profile-pref">
                            <div>
                                <p class="profile-pref-name">نیاز به تأیید مدیر</p>
                                <p class="profile-pref-desc">دیدگاه‌ها قبل از نمایش عمومی توسط مدیر تأیید شوند.</p>
                            </div>
                            <label class="profile-switch"><input type="checkbox"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                        </div>
                        <div class="profile-pref">
                            <div>
                                <p class="profile-pref-name">فقط کاربران لاگین کرده</p>
                                <p class="profile-pref-desc">فقط کاربران وارد شده بتوانند دیدگاه بگذارند.</p>
                            </div>
                            <label class="profile-switch"><input type="checkbox" checked><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                        </div>
                        <div class="profile-pref">
                            <div>
                                <p class="profile-pref-name">سیستم لایک</p>
                                <p class="profile-pref-desc">امکان لایک کردن دیدگاه‌ها.</p>
                            </div>
                            <label class="profile-switch"><input type="checkbox" checked><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </section>

    <!-- Add / Edit news modal (UI only) -->
    <div class="admin-modal" id="newsModal" hidden>
        <div class="admin-modal-backdrop" data-close-modal></div>
        <div class="admin-modal-card glass-strong" role="dialog" aria-modal="true" aria-labelledby="newsModalTitle">
            <button type="button" class="admin-modal-close" data-close-modal aria-label="بستن">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
            </button>
            <h3 id="newsModalTitle">خبر جدید</h3>
            <p class="admin-modal-sub">اطلاعات خبر را وارد کنید. این فرم فقط ظاهر است و بک‌اند بعداً اضافه می‌شود.</p>

            <form class="admin-modal-form" novalidate>
                <div class="admin-form-row admin-form-row--col">
                    <label>عنوان خبر</label>
                    <input type="text" class="profile-input" placeholder="مثلاً: ثبت نام آزمون سراسری">
                </div>
                <div class="admin-form-row admin-form-row--col">
                    <label>دسته‌بندی</label>
                    <input type="text" class="profile-input" placeholder="مثلاً: ثبت نام">
                </div>
                <div class="admin-form-row admin-form-row--col">
                    <label>چکیده</label>
                    <textarea class="profile-input profile-textarea" rows="2" placeholder="یک یا دو جمله کوتاه..."></textarea>
                </div>
                <div class="admin-form-row admin-form-row--col">
                    <label>متن کامل</label>
                    <textarea class="profile-input profile-textarea" rows="6" placeholder="متن خبر..."></textarea>
                </div>
                <div class="admin-form-grid">
                    <div class="admin-form-row admin-form-row--col">
                        <label>تاریخ انتشار</label>
                        <input type="text" class="profile-input" placeholder="۱۴۰۴/۰۶/۱۲">
                    </div>
                    <div class="admin-form-row admin-form-row--col">
                        <label>مهلت ثبت‌نام</label>
                        <input type="text" class="profile-input" placeholder="۱۴۰۴/۰۷/۰۱">
                    </div>
                </div>
                <div class="admin-form-row admin-form-row--col">
                    <label>مدارک (هر مورد در یک خط)</label>
                    <textarea class="profile-input profile-textarea" rows="3" placeholder="کارت ملی&#10;شناسنامه&#10;مدرک تحصیلی"></textarea>
                </div>
                <div class="admin-form-row admin-form-row--col">
                    <label>شرایط (هر مورد در یک خط)</label>
                    <textarea class="profile-input profile-textarea" rows="3" placeholder="تابعیت ایران&#10;عدم منع قانونی"></textarea>
                </div>

                <div class="admin-modal-actions">
                    <button type="button" class="btn btn-ghost" data-close-modal>انصراف</button>
                    <button type="button" class="btn btn-solid" disabled>
                        <span>ذخیره (به‌زودی)</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        "use strict";
        const root = document.querySelector('.admin-zone');
        if (!root) return;

        // Tab switching
        const tabs = root.querySelectorAll('.admin-tab');
        const panels = root.querySelectorAll('.admin-panel');
        function showPanel(name) {
            tabs.forEach(t => t.classList.toggle('is-active', t.dataset.tab === name));
            panels.forEach(p => p.classList.toggle('is-active', p.dataset.panel === name));
            try {
                const url = new URL(window.location.href);
                url.searchParams.set('tab', name);
                history.replaceState(null, '', url);
            } catch (e) { }
        }
        tabs.forEach(t => t.addEventListener('click', () => showPanel(t.dataset.tab)));
        try {
            const params = new URLSearchParams(window.location.search);
            const t = params.get('tab');
            if (t && root.querySelector('[data-tab="' + t + '"]')) showPanel(t);
        } catch (e) { }

        // Filter group
        root.querySelectorAll('.admin-filter-group').forEach(group => {
            group.addEventListener('click', e => {
                const btn = e.target.closest('button');
                if (!btn) return;
                group.querySelectorAll('button').forEach(b => b.classList.remove('is-active'));
                btn.classList.add('is-active');
            });
        });

        // Modal
        const modal = root.querySelector('#newsModal');
        if (modal) {
            const openBtn = root.querySelector('[data-action="new-news"]');
            const closeEls = modal.querySelectorAll('[data-close-modal]');
            function openModal() { modal.hidden = false; document.body.style.overflow = 'hidden'; }
            function closeModal() { modal.hidden = true; document.body.style.overflow = ''; }
            if (openBtn) openBtn.addEventListener('click', openModal);
            closeEls.forEach(el => el.addEventListener('click', closeModal));
            document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });
        }
    })();
</script>
