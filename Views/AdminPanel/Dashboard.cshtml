@{
    Layout = "_Layout";
    ViewData["Title"] = "پنل مدیریت | کافینت آریا";

    ViewData["HideFooter"] = true;
}

@section Styles {
    @* Loads before theme-light.css (the layout renders this section right before it). *@
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true" />
}

<div class="admin-zone" id="adminZone">
    <canvas class="starfield-canvas" data-count="20" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>

    <partial name="_AdminIcons" />

    <div class="admin-shell" id="adminShell">
        <script>
            /* tiny pre-paint step: restore the collapsed rail before first paint (no layout jump). Everything else lives in admin-panel.js */
            try { if (localStorage.getItem('admin.sidebar.collapsed') === '1') document.getElementById('adminShell').classList.add('is-collapsed'); } catch (e) { }
        </script>

        <partial name="_AdminSidebar" />

        <div class="admin-main" id="adminMain">
            <!-- Top bar -->
            <div class="admin-topbar">
                <button type="button" class="admin-icon-btn admin-menu-btn" id="adminMenuBtn" aria-label="باز کردن منو" aria-controls="adminSidebar" aria-expanded="false">
                    <svg class="admin-ico" aria-hidden="true"><use href="#ad-menu"></use></svg>
                </button>
                <nav class="admin-breadcrumb" aria-label="مسیر صفحه">
                    <ol>
                        <li>پنل مدیریت</li>
                        <li id="crumbGroup" hidden></li>
                        <li id="crumbPage" aria-current="page">داشبورد</li>
                    </ol>
                </nav>
                <div class="admin-topbar-tools">
                    <div class="admin-search admin-topbar-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        <input type="search" id="adminGlobalSearch" placeholder="جستجو در پنل..." aria-label="جستجو در پنل مدیریت">
                    </div>
                    <button type="button" class="admin-icon-btn admin-bell" id="adminBell" aria-label="اعلان‌ها">
                        <svg class="admin-ico" aria-hidden="true"><use href="#ad-bell"></use></svg>
                        <span class="admin-bell-dot" aria-hidden="true"></span>
                    </button>
                </div>
            </div>

            <!-- Page header (compact) -->
            <section class="admin-hero">
                <div class="admin-hero-inner">
                    <div>
                        <p class="eyebrow on-dark">پنل مدیریت</p>
                        <h1 class="admin-hero-title">کافینت آریا — کنترل مرکزی</h1>
                        <p class="admin-hero-sub">از اینجا می‌توانید اخبار، دیدگاه‌ها و سایر بخش‌های سایت را مدیریت کنید.</p>
                    </div>
                    <div class="admin-hero-stats">
                        <div class="admin-hero-stat">
                            <span class="admin-hero-stat-num" data-count="0">۰</span>
                            <span class="admin-hero-stat-label">خبر فعال</span>
                        </div>
                        <div class="admin-hero-stat">
                            <span class="admin-hero-stat-num" data-count="0">۰</span>
                            <span class="admin-hero-stat-label">دیدگاه</span>
                        </div>
                        <div class="admin-hero-stat">
                            <span class="admin-hero-stat-num" data-count="0">۰</span>
                            <span class="admin-hero-stat-label">کاربر</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Panels: one section.admin-panel[data-panel] per menu item -->
            <div class="admin-body" id="adminBody">
                <partial name="_PanelOverview" />
                <partial name="_PanelEditor" />
                <partial name="_PanelNews" />
                <partial name="_PanelComments" />
                <partial name="_PanelUsers" />
                <partial name="_PanelSettings" />
                <partial name="_PanelsGeneric" />
            </div>
        </div>
    </div>

    <partial name="_AdminNewsModal" />
    <partial name="_AdminLogoutModal" />

    <div class="admin-toasts" id="adminToasts" aria-live="polite" aria-atomic="false"></div>
    <div class="admin-tip" id="adminTip" role="tooltip" hidden></div>
</div>

@section Scripts {
    <script src="~/js/admin-panel.js" asp-append-version="true"></script>
}
