<!-- Logout confirmation (UI only). Built on the page's .admin-modal pattern (backdrop, card, close button).
     The "خروج" button submits the real logout form in _AdminSidebar (id="adminLogoutForm": same POST + anti-forgery token). -->
<div class="admin-modal admin-modal--confirm" id="logoutModal" hidden>
    <div class="admin-modal-backdrop" data-close-modal></div>
    <div class="admin-modal-card admin-modal-card--confirm glass-strong" role="alertdialog" aria-modal="true" aria-labelledby="logoutModalTitle" aria-describedby="logoutModalText">
        <button type="button" class="admin-modal-close" data-close-modal aria-label="بستن">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
        </button>
        <span class="admin-confirm-ico" aria-hidden="true"><svg class="admin-ico"><use href="#ad-logout"></use></svg></span>
        <h3 id="logoutModalTitle">خروج از حساب</h3>
        <p class="admin-modal-sub" id="logoutModalText">آیا مطمئن هستید که می‌خواهید از حساب کاربری خود خارج شوید؟</p>
        <div class="admin-modal-actions">
            <button type="button" class="btn btn-ghost" data-close-modal data-autofocus>انصراف</button>
            <button type="submit" form="adminLogoutForm" class="btn btn-danger">خروج</button>
        </div>
    </div>
</div>
