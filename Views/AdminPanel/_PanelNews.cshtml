@* Existing news-management panel (sample rows), moved from the old tab layout. UI only. *@
<section class="admin-panel" data-panel="news" aria-label="مدیریت اخبار">
    <header class="admin-panel-head">
        <div>
            <h2 class="admin-panel-title">مدیریت اخبار</h2>
            <p class="admin-panel-desc">فهرست خبرهای سایت. ردیف‌ها نمونه‌اند و بعد از اتصال بک‌اند از پایگاه داده خوانده می‌شوند.</p>
        </div>
    <span class="admin-tag admin-tag--sample">داده نمونه</span>
    </header>
        <div class="admin-toolbar">
            <div class="admin-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" placeholder="جستجوی خبر...">
            </div>
            <button class="btn btn-solid" data-action="new-news">
                <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                <span>افزودن خبر جدید</span>
            </button>
        </div>

        <div class="admin-list" id="adminNewsList">
            <!-- Sample news items (UI placeholders) -->
            <article class="admin-row">
                <div class="admin-row-thumb">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="2.5" x2="8" y2="6.5" /><line x1="16" y1="2.5" x2="16" y2="6.5" /></svg>
                </div>
                <div class="admin-row-body">
                    <h4>نمونه خبر اول</h4>
                    <p>این یک نمونه پیش‌نمایش خبر است که بعداً از بک‌اند بارگذاری می‌شود.</p>
                    <div class="admin-row-meta">
                        <span class="admin-tag admin-tag--ok">فعال</span>
                        <span>۱۴۰۴/۰۶/۱۲</span>
                        <span>۱۲ دیدگاه</span>
                    </div>
                </div>
                <div class="admin-row-actions">
                    <button class="admin-row-btn" title="ویرایش" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                    </button>
                    <button class="admin-row-btn admin-row-btn--danger" title="حذف" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6" /></svg>
                    </button>
                </div>
            </article>

            <article class="admin-row">
                <div class="admin-row-thumb">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="2.5" x2="8" y2="6.5" /><line x1="16" y1="2.5" x2="16" y2="6.5" /></svg>
                </div>
                <div class="admin-row-body">
                    <h4>نمونه خبر دوم</h4>
                    <p>پیش‌نمایش دومین خبر — بعد از اتصال به بک‌اند، لیست واقعی نمایش داده می‌شود.</p>
                    <div class="admin-row-meta">
                        <span class="admin-tag admin-tag--warn">پیش‌نویس</span>
                        <span>۱۴۰۴/۰۶/۰۸</span>
                        <span>۰ دیدگاه</span>
                    </div>
                </div>
                <div class="admin-row-actions">
                    <button class="admin-row-btn" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                    </button>
                    <button class="admin-row-btn admin-row-btn--danger" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6" /></svg>
                    </button>
                </div>
            </article>
        </div>

        <div class="admin-empty" id="adminNewsEmpty" hidden>
            <div class="admin-empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><line x1="3" y1="11" x2="21" y2="11" /></svg>
            </div>
            <h3>هنوز خبری اضافه نشده</h3>
            <p>با کلیک روی «افزودن خبر جدید» اولین خبر خود را بسازید.</p>
        </div>

        <p class="profile-hint profile-hint--block admin-hint-block">
            بک‌اند این بخش بعداً اضافه می‌شود. در حال حاضر فقط رابط کاربری آماده است.
        </p>
</section>
