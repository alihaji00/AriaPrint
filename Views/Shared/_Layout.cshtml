<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>کافینت آریا | همیشه یک قدم جلوتر از شما</title>
    @* <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <partial name="_SvgSprite"></partial>
        <div class="container header-inner">
            <a class="logo" href="/">
                <span class="ph ph-mono logo-icon"><svg><use href="#ph-mono"></use></svg></span>
                <span class="logo-text">کافینت آریا</span>
            </a>

            <nav class="main-nav" id="mainNav">
                <a href="/" class="active">خانه</a>
                <a href="#services">خدمات</a>
                <a href="#about">درباره ما</a>
                <a href="#news">اخبار</a>
                <a href="#contact">تماس با ما</a>
            </nav>

            <a href="#contact" class="btn-header-cta">تماس با ما</a>

            <button class="nav-toggle" id="navToggle" aria-label="باز کردن منو">

                <svg class="block" fill="none" height="32" viewBox="0 0 24 24" width="32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width: 32px; height: 32px;"><path fill="white" d="M21 18a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2zm0-7a1 1 0 1 1 0 2H3a1 1 0 1 1 0-2zm0-7a1 1 0 1 1 0 2H3a1 1 0 0 1 0-2z"></path></svg>

                @* @else
                {
                    <svg class="block" fill="none" height="32" viewBox="0 0 24 24" width="32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width: 32px; height: 32px;"><path fill="currentColor" d="M16.7929 5.79289C17.1834 5.40237 17.8164 5.40237 18.207 5.79289C18.5975 6.18342 18.5975 6.81643 18.207 7.20696L14.8282 10.5857C14.0472 11.3668 14.0472 12.6331 14.8282 13.4141L18.207 16.7929C18.5975 17.1834 18.5975 17.8164 18.207 18.207C17.8164 18.5975 17.1834 18.5975 16.7929 18.207L13.4141 14.8282C12.6331 14.0472 11.3668 14.0472 10.5857 14.8282L7.20696 18.207C6.81643 18.5975 6.18342 18.5975 5.79289 18.207C5.40237 17.8164 5.40237 17.1834 5.79289 16.7929L9.17165 13.4141C9.9527 12.6331 9.9527 11.3668 9.17165 10.5857L5.79289 7.20696C5.40237 6.81643 5.40237 6.18342 5.79289 5.79289C6.18342 5.40237 6.81643 5.40237 7.20696 5.79289L10.5857 9.17165C11.3668 9.9527 12.6331 9.9527 13.4141 9.17165L16.7929 5.79289Z"></path></svg>
                } *@

            </button>
            
        </div>
    </header>
    @RenderBody()
    <footer class="site-footer" id="contact">
        <canvas class="starfield-canvas" data-count="10" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>
        <div class="container testimonial-row">

            <div class="brand-side">
                <a class="brand-heading" href="/">
                    <span class="ph ph-mono"><svg><use href="#ph-mono"></use></svg></span>
                    <span>کافینت آریا</span>
                </a>
                <p>ارائه دهنده انواع خدمات اینترنتی و اداری با کیفیت بالا و قیمت مناسب</p>
                <div class="social-row">
                    <a class="social-circle" href="#" aria-label="اینستاگرام"><svg><use href="#i-instagram"></use></svg></a>
                    <a class="social-circle" href="#" aria-label="تلگرام"><svg><use href="#i-telegram"></use></svg></a>
                    <a class="social-circle" href="#" aria-label="واتساپ"><svg><use href="#i-whatsapp"></use></svg></a>
                </div>
            </div>

            <div class="quote-side">
                <div class="testimonial-slider">
                    <button class="slider-btn slider-btn--prev" id="prevTestimonial" aria-label="نظر قبلی"><svg><use href="#i-chevron-left"></use></svg></button>

                    <div class="testimonial-card">
                        <span class="quote-glyph quote-glyph--tr" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#i-quote"></use></svg></span>
                        <span class="quote-glyph quote-glyph--bl" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#i-quote"></use></svg></span>
                        <p class="eyebrow on-dark">نظر مشتریان ما</p>
                        <p class="quote-text" id="quoteText">از سرعت عمل و برخورد حرفه‌ای کافینت آریا بسیار راضی هستم. همیشه بهترین انتخاب من بوده‌اند.</p>
                        <div class="stars" id="quoteStars">
                            <svg><use href="#i-star"></use></svg>
                            <svg><use href="#i-star"></use></svg>
                            <svg><use href="#i-star"></use></svg>
                            <svg><use href="#i-star"></use></svg>
                            <svg><use href="#i-star"></use></svg>
                        </div>
                        <p class="author-name" id="authorName">مریم احمدی</p>
                        <p class="author-role" id="authorRole">دانشجو</p>
                    </div>

                    <button class="slider-btn slider-btn--next" id="nextTestimonial" aria-label="نظر بعدی"><svg><use href="#i-chevron-right"></use></svg></button>
                </div>
            </div>

        </div>

        <div class="container footer-grid">

            <div class="footer-col">
                <h4>دسترسی سریع</h4>
                <ul>
                    <li><a href="#home">خانه</a></li>
                    <li><a href="#services">خدمات</a></li>
                    <li><a href="#news">اخبار</a></li>
                    <li><a href="#about">درباره ما</a></li>
                    <li><a href="#contact">تماس با ما</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>خدمات</h4>
                <ul>
                    <li><a href="#services">پرینت و کپی</a></li>
                    <li><a href="#services">ثبت نام</a></li>
                    <li><a href="#services">خدمات دانشجویی</a></li>
                    <li><a href="#services">پرداخت قبوض</a></li>
                    <li><a href="#services">اسکن و تایپ</a></li>
                </ul>
            </div>

            <div class="footer-col" id="footer-col-call">
                <h4>اطلاعات تماس</h4>
                <div class="contact-item"><svg><use href="#i-phone"></use></svg><span>۰۹۹۲-۳۳۶-۵۳۷۳</span></div>
                <div class="contact-item"><svg><use href="#i-mobile"></use></svg><span>۰۹۱۶-۷۷۶-۲۹۳۲</span></div>
                <div class="contact-item"><svg><use href="#i-pin"></use></svg><span>بهبهان، خیابان کرم نسب، جنب سردخانه توچال</span></div>
                <div class="contact-item"><svg><use href="#i-mail"></use></svg><span dir="ltr">ariacafeenet@gmail.com</span></div>
            </div>

            <div class="footer-col">
                <h4>ساعات کاری</h4>
                <div class="hours-item">
                    <span class="hours-icon-wrap"><svg><use href="#i-clock"></use></svg></span>
                    <div><p class="hours-day">تایم صبح</p><p class="hours-time">۸:۰۰ - ۱۳:۰۰</p></div>
                </div>
                <div class="hours-item">
                    <span class="hours-icon-wrap"><svg><use href="#i-clock"></use></svg></span>
                    <div><p class="hours-day">تایم عصر</p><p class="hours-time">۱۷:۰۰ - ۲۲:۰۰</p></div>
                </div>
            </div>

        </div>

        <div class="container footer-bottom">
            <p dir="ltr" style="display:flex; align-items:center; justify-content:center; gap:8px; margin:0;">
                Created by
                <span class="shine">
                    <a href="www.alihaji.com">
                        ᯓ
                        𝖆𝖑𝖎𝖍𝖆𝖏𝖎
                        <span style="transform:scaleX(-1);display:inline-block">
                            ᯓ

                        </span>
                    </a>
                </span>
                with
                <svg style="margin-bottom:0.5vh;" width="16" height="16" class="icon-love">
                    <use href="#i-heart"></use>
                </svg>
                &
                <svg class="icon-coffee" style="margin-bottom:0.7vh; viewBox="0 0 24 24" width="28" height="28" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <style>
                            .coffee-steam {
                                fill: none;
                                @* stroke: gold;
                                stroke-width: 1.4; *@
                                stroke-linecap: round;
                                @* opacity: 0; *@
                                transform-origin: center bottom;
                                animation: steam-rise 2.2s ease-in-out infinite;
                            }

                                .coffee-steam.s2 {
                                    animation-delay: 0.4s;
                                }

                                .coffee-steam.s3 {
                                    animation-delay: 0.8s;
                                }

                            @@keyframes steam-rise {
                                0% {
                                    opacity: 0;
                                    transform: translateY(0) scaleY(0.8);
                                }

                                25% {
                                    opacity: 0.9;
                                }

                                70% {
                                    opacity: 0.35;
                                }

                                100% {
                                    opacity: 0;
                                    transform: translateY(-6px) scaleY(1.15);
                                }
                            }

                            .coffee-cup {
                                fill: none;
                                @* stroke: gold;
                                stroke-width: 1.4; *@
                                stroke-linecap: round;
                                stroke-linejoin: round;
                            }
                        </style>
                    </defs>

                    <!-- steam wisps -->
                    <path class="coffee-steam s1" d="M8 8c1.2-1.4-1.2-2.6 0-4" />
                    <path class="coffee-steam s2" d="M12 8c1.2-1.4-1.2-2.6 0-4" />
                    <path class="coffee-steam s3" d="M16 8c1.2-1.4-1.2-2.6 0-4" />

                    <!-- cup + handle + base line -->
                    <path class="coffee-cup" d="M6 10h11v5a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4v-5z" />
                    <path class="coffee-cup" d="M17 11h1.5a2 2 0 0 1 0 4H17" />
                    <path class="coffee-cup" d="M6 20h11" />
                </svg>
            </p>
        </div>

    </footer>

    <script>
        // mobile nav toggle
        const navToggle = document.getElementById('navToggle');
        const mainNav = document.getElementById('mainNav');
        if (navToggle && mainNav) {
          navToggle.addEventListener('click', () => mainNav.classList.toggle('open'));
          mainNav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mainNav.classList.remove('open')));
        }

        // testimonial slider — ready for more entries; add objects to this array later

        @{
            var Feedbacks = new SetFeedbacks();
            var FeedbacksList = Feedbacks.GetFeedbacks()
            .Select(c => new
            {
                text = c.Text,
                name = c.Name,
                role = c.Role,
                rating = c.Rating,
            });
        }

        const testimonials = @Json.Serialize(FeedbacksList);

        let tIndex = 0;
        const quoteText = document.getElementById('quoteText');
        const authorName = document.getElementById('authorName');
        const authorRole = document.getElementById('authorRole');
        const starsWrap = document.getElementById('quoteStars');

        function renderTestimonial(i){
          const t = testimonials[i];
          quoteText.textContent = t.text;
          authorName.textContent = t.name;
          authorRole.textContent = t.role;
          starsWrap.innerHTML = Array.from({length:5}).map((_,s) =>
            `<svg style="${s < t.rating ? '' : 'opacity:.3'}"><use href="#i-star"></use></svg>`
          ).join('');
        }

        document.getElementById('prevTestimonial').addEventListener('click', () => {
          tIndex = (tIndex - 1 + testimonials.length) % testimonials.length;
          renderTestimonial(tIndex);
        });
        document.getElementById('nextTestimonial').addEventListener('click', () => {
          tIndex = (tIndex + 1) % testimonials.length;
          renderTestimonial(tIndex);
        });
    </script>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/starfield.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
