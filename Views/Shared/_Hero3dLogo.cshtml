<div class="hero-graphic">
    <div class="hero-video-wrap">
        <video id="sourceVideo" autoplay loop muted playsinline disablePictureInPicture tabindex="-1"
               controlsList="nodownload nofullscreen noremoteplayback" aria-hidden="true"
               style="position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;">
            <source src="~/videos/Aria3d.mp4" type="video/mp4">
        </video>
        <canvas id="heroCanvas" class="hero-video" width="400" height="440" aria-hidden="true"></canvas>
        <div class="hero-video-shield"></div>
    </div>
</div>

<script>
    (function () {
        const video = document.getElementById('sourceVideo');
        const canvas = document.getElementById('heroCanvas');
        if (!video || !canvas) return;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });

        let running = false;
        let vfcId = null;
        let rafId = null;

        function resizeCanvas() {
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (video.readyState >= 2 && video.videoWidth) {
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const data = imageData.data;
                for (let i = 0; i < data.length; i += 4) {
                    if (data[i] < 30 && data[i + 1] < 30 && data[i + 2] < 30) {
                        data[i + 3] = 0;
                    }
                }
                ctx.putImageData(imageData, 0, 0);
            }
        }

        function schedule() {
            if (!running) return;
            if (video.requestVideoFrameCallback) {
                vfcId = video.requestVideoFrameCallback(tick);
            } else {
                rafId = requestAnimationFrame(tick);
            }
        }

        function tick() {
            draw();
            schedule();
        }

        function startLoop() {
            if (running) return;
            running = true;
            schedule();
        }

        function stopLoop() {
            running = false;
            if (vfcId !== null && video.cancelVideoFrameCallback) video.cancelVideoFrameCallback(vfcId);
            if (rafId !== null) cancelAnimationFrame(rafId);
            vfcId = rafId = null;
        }

        function playVideo() {
            const p = video.play();
            if (p && p.catch) {
                p.catch(function () {
                    document.body.addEventListener('click', function () { video.play(); }, { once: true });
                });
            }
        }

        window.addEventListener('resize', resizeCanvas);
        video.addEventListener('loadedmetadata', function () {
            canvas.style.aspectRatio = video.videoWidth + ' / ' + video.videoHeight;
            resizeCanvas();
        });
        video.addEventListener('play', function () { resizeCanvas(); startLoop(); });
        video.addEventListener('pause', stopLoop);

        window.addEventListener('pageshow', function () {
            stopLoop();
            resizeCanvas();
            playVideo();
            if (!video.paused) startLoop();
        });
        window.addEventListener('pagehide', function () {
            stopLoop();
            video.pause();
        });
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) {
                video.pause();
            } else {
                playVideo();
            }
        });

        resizeCanvas();
        playVideo();
    })();
</script>