@model CommentsViewModel

<div class="comments-section">
    <section class="qa-section" id="qaSection">

        <!-- هدر بخش -->
        <div class="qa-header">
            <h2 class="qa-title">
                <span class="qa-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 11.5C21.0034 12.82 20.6951 14.12 20.1 15.3C19.3944 16.7118 18.3097 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0035 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92176 4.44061 8.37485 5.27072 7.03258C6.10083 5.69031 7.28825 4.6056 8.7 3.90003C9.87812 3.30496 11.1801 2.99659 12.5 3.00003H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                پرسش و پاسخ
            </h2>
        </div>

        <!-- فرم ثبت سوال جدید -->
        <form asp-controller="Home" asp-action="Comments" method="post" class="qa-form" id="qaForm">
            <input type="hidden" asp-for="NewComment.NewsId" />

            <div class="qa-form-row qa-form-row-double">
                <div class="qa-field">
                    <input asp-for="NewComment.FullName" type="text" id="qaName" class="qa-input" placeholder="نام و نام خانوادگی" autocomplete="name" required>
                </div>

                <div class="qa-field">
                    <input asp-for="NewComment.PhoneNumber" type="tel" id="qaPhone" class="qa-input" placeholder="شماره موبایل" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" required>
                </div>
            </div>

            <div class="qa-form-row qa-form-row-submit">
                <input asp-for="NewComment.Text" type="text" id="qaComment" class="qa-input" placeholder="سوال خود را اینجا بنویسید..." required>
                <button type="submit" class="qa-submit-btn">ارسال سوال</button>
            </div>

            <p class="qa-hint">لطفاً سوال خود را با جزئیات مطرح کنید تا بهتر راهنمایی شوید.</p>
        </form>

        <!-- لیست سوالات و پاسخ‌ها -->
        <div class="qa-list" id="qaList">

            @foreach (var item in Model.CommentsList)
            {
                <article class="qa-item">
                    <div class="qa-item-top">
                        <div class="qa-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 12C14.2091 12 16 10.2091 16 8C16 5.79086 14.2091 4 12 4C9.79086 4 8 5.79086 8 8C8 10.2091 9.79086 12 12 12Z" stroke="currentColor" stroke-width="1.6" />
                                <path d="M4.5 20C5.72925 16.9704 8.63324 15 12 15C15.3668 15 18.2708 16.9704 19.5 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="qa-user-meta">
                            <span class="qa-username">@item.FullName</span>
                            <span class="qa-time">۲ روز پیش</span>
                        </div>
                    </div>

                    <p class="qa-question">@item.Text</p>

                    <button class="qa-reply-btn" type="button" data-question-id="@item.CommentId">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 14L4 9L9 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M4 9H15C17.7614 9 20 11.2386 20 14C20 16.7614 17.7614 19 15 19H11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        پاسخ
                    </button>

                    @{
                        int id = item.CommentId;
                        var answer = Model.AnswersList.FirstOrDefault(a => a.AnswerId == id);
                    }

                    @if (answer != null)
                    {
                        <div class="qa-answer">
                            <div class="qa-answer-top">
                                <div class="qa-avatar qa-avatar-support" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M4 13V11C4 6.58172 7.58172 3 12 3C16.4183 3 20 6.58172 20 11V13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                        <rect x="3" y="13" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                                        <rect x="17" y="13" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.7" />
                                        <path d="M20 19C20 20.6569 18.6569 22 17 22H14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                    </svg>
                                </div>
                                <span class="qa-answer-name">پشتیبانی کافینت آریا</span>
                            </div>
                            <p class="qa-answer-text">@answer.Text</p>
                            <button class="qa-like-btn" type="button">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M7 10V21H4C3.44772 21 3 20.5523 3 20V11C3 10.4477 3.44772 10 4 10H7ZM7 10L11.6923 3.3945C12.0735 2.85567 12.7963 2.68664 13.376 3.00227C14.5164 3.62194 15.1622 4.87275 14.9829 6.15626L14.5 9.6H18.9925C20.0684 9.6 20.9 10.5305 20.8055 11.6023L20.0949 19.6023C20.0104 20.5606 19.2077 21.3 18.2456 21.3H10C8.34315 21.3 7 19.9569 7 18.3V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                </svg>
                                <span class="qa-like-count" data-count="8">۸</span>
                            </button>
                        </div>
                    }



                </article>
            }

