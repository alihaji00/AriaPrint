@model CommentsViewModel

<div class="comments-section">
    <section class="qa-section" id="qaSection">

        <!-- هدر بخش -->
        <div class="qa-header">
            <h2 class="qa-title">
                <span class="qa-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 11.5C21.0034 12.82 20.6951 14.12 20.1 15.3C19.3944 16.7118 18.3097 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0035 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92176 4.44061 8.37485 5.27072 7.03258C6.10083 5.69031 7.28825 4.6056 8.7 3.90003C9.87812 3.30496 11.1801 2.99659 12.5 3.00003H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                پرسش و پاسخ
            </h2>
        </div>

        <!-- فرم ثبت سوال جدید -->
        <form asp-controller="Home" asp-action="Comments" method="post" class="qa-form" id="qaForm">
            <input type="hidden" asp-for="NewComment.NewsId" />

            <div class="qa-form-row qa-form-row-double">
                <div class="qa-field">
                    <input asp-for="NewComment.FullName" type="text" id="qaName" class="qa-input" placeholder="نام و نام خانوادگی" autocomplete="name" required>
                </div>

                <div class="qa-field">
                    <input asp-for="NewComment.PhoneNumber" type="tel" id="qaPhone" class="qa-input" placeholder="شماره موبایل" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" required>
                </div>
            </div>

            <div class="qa-form-row qa-form-row-submit">
                <input asp-for="NewComment.Text" type="text" id="qaComment" class="qa-input" placeholder="سوال خود را اینجا بنویسید..." required>
                <button type="submit" class="qa-submit-btn">ارسال سوال</button>
            </div>

            <p class="qa-hint">لطفاً سوال خود را با جزئیات مطرح کنید تا بهتر راهنمایی شوید.</p>
        </form>

        <!-- لیست سوالات و پاسخ‌ها -->
        <div class="qa-list" id="qaList">

            @{
                var Top3Comments = Model.CommentsList.OrderByDescending(c => c.CommentId).Take(3).ToArray();
            }

            @foreach (var item in Top3Comments)
            {
                <article class="qa-item">

                    <partial name="_Comment" model="item"></partial>

                    @{
                        int id = item.CommentId;
                        var answer = Model.AnswersList.FirstOrDefault(a => a.AnswerId == id);
                    }

                    @if (answer != null)
                    {
                        <partial name="_Answer" model="answer"></partial>
                    }

                </article>
            }

                    @* 
                    <p class="qa-answer-text">حداقل مبلغ وام ازدواج ۲۲۰ میلیون تومان و حداکثر ۳۰۰ میلیون تومان است.</p>
                     *@



            <!-- این دو مورد با کلیک روی «مشاهده همه سوالات» نمایش داده می‌شوند -->
            @if (Model.CommentsList.Count > 3)
            {

                var OtherComments = Model.CommentsList.OrderByDescending(c => c.CommentId).Skip(3).ToArray();

                @foreach (var item in OtherComments)
                {
                    <article class="qa-item qa-item-hidden">

                        <partial name="_Comment" model="item"></partial>

                        @{
                            int id = item.CommentId;
                            var answer = Model.AnswersList.FirstOrDefault(a => a.AnswerId == id);
                        }

                        @if (answer != null)
                        {
                            <partial name="_Answer" model="answer"></partial>
                        }

                    </article>
                }
            }
        </div>

        <!-- دکمه مشاهده همه سوالات -->
        @if (Model.CommentsList.Count > 3)
        {
            <button class="qa-viewall-btn" id="qaViewAllBtn" type="button">
                <span>مشاهده همه سوالات</span>
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        }

    </section>

</div>



<script>
    (function () {
      "use strict";

      var persianDigits = ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"];
      function toPersianDigits(input) {
        return String(input).replace(/[0-9]/g, function (d) { return persianDigits[d]; });
      }

      // ---- toggle like buttons ----
      function bindLikeButton(btn) {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", function () {
          var countEl = btn.querySelector(".qa-like-count");
          var count = parseInt(countEl.getAttribute("data-count") || "0", 10);
          var liked = btn.classList.toggle("qa-like-btn-active");
          count = liked ? count + 1 : count - 1;
          countEl.setAttribute("data-count", count);
          countEl.textContent = toPersianDigits(count);
        });
      }

      // ---- toggle inline reply box under a question ----
      function bindReplyButton(btn) {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", function () {
          var existing = btn.nextElementSibling;
          if (existing && existing.classList.contains("qa-reply-box")) {
            existing.remove();
            btn.classList.remove("qa-reply-btn-active");
            return;
          }

          btn.classList.add("qa-reply-btn-active");

          var commentId = btn.dataset.questionId;
          var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
          var tokenValue = tokenInput ? tokenInput.value : "";

          var box = document.createElement("div");
          box.className = "qa-reply-box";
          box.innerHTML =
            '<form method="post" action="/Home/Answers" class="qa-reply-form qa-reply-box">' +
                '<input type="hidden" name="__RequestVerificationToken" value="' + tokenValue + '">' +
                '<input type="hidden" name="AnswerId" value="' + commentId + '">' +
                '<input name="Text" type="text" class="qa-input qa-reply-input" placeholder="پاسخ خود را بنویسید...">' +
                '<button type="submit" class="qa-reply-send">ارسال</button>' +
            '</form>';



          btn.insertAdjacentElement("afterend", box);

        });
      }

      document.querySelectorAll(".qa-like-btn").forEach(bindLikeButton);
      document.querySelectorAll(".qa-reply-btn").forEach(bindReplyButton);

      // ---- show / hide extra questions ----
      var viewAllBtn = document.getElementById("qaViewAllBtn");
      var expanded = false;

      viewAllBtn.addEventListener("click", function () {
        expanded = !expanded;
        document.querySelectorAll(".qa-item-hidden").forEach(function (el) {
          el.style.display = expanded ? "block" : "none";
        });
        viewAllBtn.querySelector("span").textContent = expanded ? "نمایش کمتر" : "مشاهده همه سوالات";
        viewAllBtn.classList.toggle("qa-viewall-btn-open", expanded);
      });
    })();
</script>
