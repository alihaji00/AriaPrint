@using AriaPrint.Repository
@model News

<article class="news-card">
    <div class="news-card-media">
        @{
            string Date = Model.ReleaseDate.ToString();
            string Year = Date.Substring(0, 4);
            string Month = Date.Substring(4, 2);
            string Day = Date.Substring(6, 2);
            string result = $"{Year}/{Month}/{Day}";
        }
        <span class="badge badge-date">@result</span>
        @if (Model.IsNew == true)
        {
            <span class="badge badge-new">جدید</span>
        }
        <span class="ph-mono-wrap"><svg class="ph-mono"><use href="@Model.PictureUrl"></use></svg></span>
    </div>
    <div class="news-card-body">
        <h3 class="news-card-title">@Model.Title</h3>
        <p class="news-card-excerpt">@Model.Summary</p>
        <a asp-controller="News" asp-action="News" asp-route-id="@Model.Id" class="read-more">
            <span>بیشتر بخوانید</span>
            <svg class="icon-sm">
                <use href="#i-chevron-left"></use>
            </svg>
        </a>
    </div>
</article>
