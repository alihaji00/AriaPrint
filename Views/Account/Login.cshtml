@{

    Layout = "_Layout";
    ViewData["Title"] = "ورود / ثبت نام | کافینت آریا";

    ViewData["HideFooter"] = true;

    // mode: "login" | "register" | "forgot"
    var mode = (Context.Request.Query["mode"].ToString() ?? "login").ToLower();
    if (mode != "login" && mode != "register" && mode != "forgot") mode = "login";

    var loginModel = new AriaPrint.Models.LoginViewModel();
    var registerModel = new AriaPrint.Models.RegisterViewModel();
    var forgotModel = new AriaPrint.Models.ForgotPasswordViewModel();
}

<!-- ================= AUTH PANEL ================= -->
<section class="auth-section">
    <canvas class="starfield-canvas" data-count="30" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>

    <div class="container auth-container">
        <div class="auth-grid">

            <!-- LEFT — visual / brand panel -->
            <aside class="auth-visual glass-strong">
                <div class="auth-visual-glow"></div>
                <a class="auth-brand" href="/">
                    <span class="ph ph-mono auth-brand-icon">
                        <svg><use href="#ph-mono"></use></svg>
                    </span>
                    <span class="auth-brand-text">کافینت آریا</span>
                </a>

                <h2 class="auth-visual-title">همیشه یک قدم جلوتر از شما</h2>
                <p class="auth-visual-desc">
                    با ساخت حساب کاربری می‌توانید روی اخبار دیدگاه بگذارید، پاسخ‌های تیم پشتیبانی را دنبال کنید و از امکانات ویژه‌ای که در راه است بهره‌مند شوید.
                </p>

                <ul class="auth-feature-list">
                    <li>
                        <span class="auth-feature-dot"><svg><use href="#i-check"></use></svg></span>
                        ارسال دیدگاه روی اخبار
                    </li>
                    <li>
                        <span class="auth-feature-dot"><svg><use href="#i-check"></use></svg></span>
                        پاسخ مستقیم از تیم پشتیبانی
                    </li>
                    <li>
                        <span class="auth-feature-dot"><svg><use href="#i-check"></use></svg></span>
                        دسترسی سریع به پنل کاربری
                    </li>
                    <li>
                        <span class="auth-feature-dot"><svg><use href="#i-check"></use></svg></span>
                        امنیت بالا با رمزگذاری استاندارد
                    </li>
                </ul>

                <div class="auth-visual-foot">
                    <span class="auth-eye">© کافینت آریا — همه حقوق محفوظ است.</span>
                </div>
            </aside>

            <!-- RIGHT — form panel -->
            <div class="auth-card glass-strong">
                <div class="auth-card-glow"></div>

                <!-- Tab switcher -->
                <div class="auth-tabs" role="tablist" aria-label="انتخاب عملیات">
                    <button type="button" class="auth-tab @(mode == "login" ? "is-active" : "")" data-target="login" role="tab" aria-selected="@(mode == "login")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
                        ورود
                    </button>
                    <button type="button" class="auth-tab @(mode == "register" ? "is-active" : "")" data-target="register" role="tab" aria-selected="@(mode == "register")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                        ثبت نام
                    </button>
                </div>

                <!-- ===== LOGIN FORM ===== -->
                <form asp-controller="Account" asp-action="Login" method="post" class="auth-form @(mode == "login" ? "is-active" : "")" data-form="login" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()
                    <h3 class="auth-form-title">خوش آمدید</h3>
                    <p class="auth-form-sub">برای ادامه وارد حساب کاربری خود شوید.</p>

                    <div class="auth-field">
                        <label asp-for="@loginModel.PhoneNumber">شماره موبایل</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><line x1="11" y1="18" x2="13" y2="18" /></svg>
                            <input asp-for="@loginModel.PhoneNumber" name="PhoneNumber" id="PhoneNumber" type="tel" class="auth-input" placeholder="۰۹۱۲۳۴۵۶۷۸۹" autocomplete="tel" inputmode="numeric" maxlength="11" required>
                        </div>
                        <span data-valmsg-for="Password" data-valmsg-replace="true" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="@loginModel.Password">رمز عبور</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <input asp-for="@loginModel.Password" type="password" name="Password" id="Password" class="auth-input auth-input-password" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" required>
                            <button type="button" class="auth-eye-btn" data-toggle-password aria-label="نمایش/مخفی کردن رمز">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span data-valmsg-for="Password" data-valmsg-replace="true" class="auth-error"></span>
                    </div>

                    <div class="auth-row-between">
                        <label class="auth-remember">
                            <input type="checkbox" name="RememberMe">
                            <span>مرا به خاطر بسپار</span>
                        </label>
                        <button type="button" class="auth-link" data-go="forgot">رمز عبور را فراموش کردم</button>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="auth-summary"></div>

                    <button type="submit" class="auth-submit" id="loginBtn">
                        <span>ورود به حساب</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                    </button>

                    <p class="auth-switch-line">حساب ندارید؟ <button type="button" class="auth-link" data-go="register">ثبت نام کنید</button></p>
                </form>

                <!-- ===== REGISTER FORM ===== -->
                <form asp-controller="Account" asp-action="Register" method="post" class="auth-form @(mode == "register" ? "is-active" : "")" data-form="register" novalidate>
                    @Html.AntiForgeryToken()
                    <h3 class="auth-form-title">ساخت حساب جدید</h3>
                    <p class="auth-form-sub">فقط چند ثانیه تا همراهی با ما فاصله دارید.</p>

                    <div class="auth-row-2">
                        <div class="auth-field">
                            <label asp-for="@registerModel.FirstName">نام</label>
                            <div class="auth-input-wrap">
                                <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                <input asp-for="@registerModel.FirstName" name="FirstName" id="FirstName" type="text" class="auth-input" placeholder="نام" autocomplete="given-name" required>
                            </div>
                            <span data-valmsg-for="FirstName" data-valmsg-replace="true" class="auth-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="@registerModel.LastName">نام خانوادگی</label>
                            <div class="auth-input-wrap">
                                <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                <input asp-for="@registerModel.LastName" name="LastName" id="LastName" type="text" class="auth-input" placeholder="نام خانوادگی" autocomplete="family-name" required>
                            </div>
                            <span data-valmsg-for="LastName" data-valmsg-replace="true" class="auth-error"></span>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label asp-for="@registerModel.PhoneNumber">شماره موبایل</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><line x1="11" y1="18" x2="13" y2="18" /></svg>
                            <input asp-for="@registerModel.PhoneNumber" name="PhoneNumber" id="PhoneNumber" type="tel" class="auth-input" placeholder="۰۹۱۲۳۴۵۶۷۸۹" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" maxlength="11" required>
                        </div>
                        <span data-valmsg-for="PhoneNumber" data-valmsg-replace="true" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="@registerModel.Password">رمز عبور</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <input asp-for="@registerModel.Password" name="Password" id="Password" type="password" class="auth-input auth-input-password" placeholder="حداقل ۸ کاراکتر" autocomplete="new-password" minlength="8" required>
                            <button type="button" class="auth-eye-btn" data-toggle-password aria-label="نمایش/مخفی کردن رمز">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span data-valmsg-for="Password" data-valmsg-replace="true" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="@registerModel.ConfirmPassword">تکرار رمز عبور</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <input asp-for="@registerModel.ConfirmPassword" name="ConfirmPassword" id="ConfirmPassword" type="password" class="auth-input auth-input-password" placeholder="رمز عبور را دوباره وارد کنید" autocomplete="new-password" minlength="8" required>
                            <button type="button" class="auth-eye-btn" data-toggle-password aria-label="نمایش/مخفی کردن رمز">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span data-valmsg-for="ConfirmPassword" data-valmsg-replace="true" class="auth-error"></span>
                    </div>

                    <div class="auth-strength" data-strength>
                        <span class="auth-strength-bar"></span>
                        <span class="auth-strength-bar"></span>
                        <span class="auth-strength-bar"></span>
                        <span class="auth-strength-bar"></span>
                        <span class="auth-strength-text">قدرت رمز: —</span>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="auth-summary"></div>

                    <button type="submit" class="auth-submit">
                        <span>ساخت حساب</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
                    </button>

                    <p class="auth-switch-line">از قبل حساب دارید؟ <button type="button" class="auth-link" data-go="login">وارد شوید</button></p>
                </form>

                <!-- ===== FORGOT PASSWORD FORM ===== -->
                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form @(mode == "forgot" ? "is-active" : "")" data-form="forgot" novalidate>
                    @Html.AntiForgeryToken()
                    <h3 class="auth-form-title">بازیابی رمز عبور</h3>
                    <p class="auth-form-sub">شماره موبایل خود را وارد کنید تا لینک بازیابی برایتان ارسال شود.</p>

                    <div class="auth-field">
                        <label asp-for="@forgotModel.PhoneNumber">شماره موبایل</label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><line x1="11" y1="18" x2="13" y2="18" /></svg>
                            <input asp-for="@forgotModel.PhoneNumber" name="PhoneNumber" id="PhoneNumber" type="tel" class="auth-input" placeholder="۰۹۱۲۳۴۵۶۷۸۹" autocomplete="tel" inputmode="numeric" pattern="09[0-9]{9}" maxlength="11" required>
                        </div>
                        <span data-valmsg-for="PhoneNumber" data-valmsg-replace="true" class="auth-error"></span>
                    </div>

                    <div class="auth-info-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5" /><line x1="12" y1="11" x2="12" y2="16.5" /><line x1="12" y1="7.6" x2="12" y2="7.6" stroke-width="2.6" /></svg>
                        <p>اگر حسابی با این شماره وجود داشته باشد، لینک بازیابی برایتان ارسال خواهد شد.</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="auth-summary"></div>

                    <button type="submit" class="auth-submit">
                        <span>ارسال لینک بازیابی</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                    </button>

                    <p class="auth-switch-line">رمز را به خاطر آوردید؟ <button type="button" class="auth-link" data-go="login">وارد شوید</button></p>
                </form>

                <!-- ===== FORGOT PASSWORD — SENT STATE ===== -->
                <div class="auth-form @(mode == "forgot-sent" ? "is-active" : "")" data-form="forgot-sent">
                    <div class="auth-success">
                        <div class="auth-success-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12.5 9.5 18 20 6" /></svg>
                        </div>
                        <h3 class="auth-form-title">درخواست ثبت شد!</h3>
                        <p class="auth-form-sub">اگر شماره وارد شده در سامانه موجود باشد، لینک بازیابی به‌زودی برایتان ارسال می‌شود. لطفاً پیامک‌های خود را بررسی کنید.</p>
                        <button type="button" class="auth-submit" data-go="login">
                            <span>بازگشت به ورود</span>
                        </button>
                    </div>
                </div>

            </div>

        </div>
    </div>
</section>

<script>
    (function () {
        "use strict";

        const root = document.querySelector('.auth-card');
        if (!root) return;

        const forms = root.querySelectorAll('.auth-form');
        const tabs = root.querySelectorAll('.auth-tab');

        function showForm(target) {
            forms.forEach(f => f.classList.toggle('is-active', f.dataset.form === target));
            tabs.forEach(t => t.classList.toggle('is-active', t.dataset.target === target));
            // sync URL mode without reloading
            try {
                const url = new URL(window.location.href);
                url.searchParams.set('mode', target);
                history.replaceState(null, '', url);
            } catch (e) { /* ignore */ }
            // focus first input of the active form
            const active = root.querySelector('.auth-form.is-active');
            if (active) {
                const firstInput = active.querySelector('input');
                if (firstInput) setTimeout(() => firstInput.focus({ preventScroll: true }), 100);
            }
        }

        // Tab clicks
        tabs.forEach(tab => {
            tab.addEventListener('click', () => showForm(tab.dataset.target));
        });

        // In-form switches
        root.querySelectorAll('[data-go]').forEach(btn => {
            btn.addEventListener('click', () => showForm(btn.dataset.go));
        });

        // Toggle password visibility
        root.querySelectorAll('[data-toggle-password]').forEach(btn => {
            btn.addEventListener('click', () => {
                const wrap = btn.closest('.auth-input-wrap');
                const input = wrap && wrap.querySelector('input');
                if (!input) return;
                const isPwd = input.type === 'password';
                input.type = isPwd ? 'text' : 'password';
                btn.classList.toggle('is-active', isPwd);
            });
        });

        // Password strength meter (register form)
        const strength = root.querySelector('[data-strength]');
        const passwordInput = root.querySelector('input[name="Password"][type="password"]');
        const bars = strength ? strength.querySelectorAll('.auth-strength-bar') : [];
        const strengthText = strength ? strength.querySelector('.auth-strength-text') : null;
        if (passwordInput && bars.length) {
            const setStrength = (val) => {
                const labels = ['خیلی ضعیف', 'ضعیف', 'متوسط', 'خوب', 'عالی'];
                const colors = ['#ff5c7a', '#ff8a4c', '#ffd84c', '#7ddc6c', '#34d399'];
                bars.forEach((b, i) => {
                    b.style.background = i < val ? colors[val - 1] : 'rgba(255,255,255,.08)';
                });
                if (strengthText) {
                    strengthText.textContent = val > 0 ? ('قدرت رمز: ' + labels[val - 1]) : 'قدرت رمز: —';
                    strengthText.style.color = val > 0 ? colors[val - 1] : '';
                }
            };

            const score = (pwd) => {
                if (!pwd) return 0;
                let s = 0;
                if (pwd.length >= 8) s++;
                if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) s++;
                if (/\d/.test(pwd)) s++;
                if (/[^A-Za-z0-9]/.test(pwd)) s++;
                return Math.min(4, s);
            };

            passwordInput.addEventListener('input', () => setStrength(score(passwordInput.value)));
        }

        // Convert digits in inputs to Persian for display while keeping actual value
        const toFa = (str) => String(str).replace(/[0-9]/g, d => '۰۱۲۳۴۵۶۷۸۹'[+d]);
        root.querySelectorAll('input[type="tel"]').forEach(inp => {
            inp.addEventListener('input', () => {
                // keep actual digits; just guard against non-digits
                const cursor = inp.selectionStart;
                const cleaned = inp.value.replace(/[^0-9]/g, '').slice(0, 11);
                if (cleaned !== inp.value) {
                    inp.value = cleaned;
                    if (cursor != null) inp.setSelectionRange(cursor, cursor);
                }
            });
        });

        // DEBUG: Form submission test
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', function(e) {
                console.log('Form submitted!');
                const phone = document.querySelector('input[name="PhoneNumber"]').value;
                const password = document.querySelector('input[name="Password"]').value;
                console.log('Phone:', phone);
                console.log('Password:', password ? '[PROVIDED]' : '[EMPTY]');
            });
        }
    })();
</script>
