@{
    Layout = "_Layout";
    ViewData["Title"] = "دسترسی محدود | کافینت آریا";
}

<section class="auth-section">
    <canvas class="starfield-canvas" data-count="20" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>
    <div class="container auth-container">
        <div class="auth-card glass-strong auth-card-solo">
            <div class="auth-card-glow"></div>
            <div class="auth-success">
                <div class="auth-success-icon auth-success-icon--warn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5" /><line x1="12" y1="8" x2="12" y2="13" /><line x1="12" y1="16.2" x2="12" y2="16.2" stroke-width="2.6" /></svg>
                </div>
                <h3 class="auth-form-title">دسترسی محدود</h3>
                <p class="auth-form-sub">شما اجازه دسترسی به این بخش را ندارید. اگر فکر می‌کنید اشتباهی رخ داده، با مدیر سایت تماس بگیرید.</p>
                <div class="auth-success-actions">
                    <a class="auth-submit" href="/">
                        <span>بازگشت به خانه</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
