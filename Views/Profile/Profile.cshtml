@model ProfileViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "پروفایل | کافینت آریا";

    ViewData["HideFooter"] = true;
}

<div class="profile-zone">
    <canvas class="starfield-canvas" data-count="30" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>

    <!-- Header strip -->
    <section class="profile-hero">
        <div class="container profile-hero-inner">
            <div class="profile-hero-left">
                <div class="profile-avatar">
                    <span id="profileAvatarText">@Model.Initial</span>
                </div>
                <div class="profile-hero-meta">
                    <p class="eyebrow on-dark">حساب کاربری</p>
                    <h1 class="profile-hero-name" id="profileName">@Model.FullName</h1>
                    <p class="profile-hero-phone" id="profilePhone">@Model.Phone</p>
                </div>
            </div>

            <div class="profile-hero-actions">
                @if (Model.IsAdmin)
                {
                    <a class="btn btn-ghost" href="/AdminPanel/Dashboard">
                        <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l9 4v6c0 5-3.5 9-9 10-5.5-1-9-5-9-10V6l9-4z" /><path d="M9 12l2 2 4-4" /></svg>
                        <span>پنل مدیریت</span>
                    </a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost profile-logout">
                        <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        <span>خروج</span>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Body grid -->
    <section class="profile-body">
        <div class="container profile-grid">

            <!-- Sidebar -->
            <aside class="profile-sidebar glass-strong">
                <nav class="profile-nav" role="tablist" aria-label="بخش‌های پروفایل">
                    <button class="profile-nav-item is-active" data-tab="overview" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        نمای کلی
                    </button>
                    <button class="profile-nav-item" data-tab="edit" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                        ویرایش اطلاعات
                    </button>
                    <button class="profile-nav-item" data-tab="security" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        امنیت و رمز عبور
                    </button>
                    <button class="profile-nav-item" data-tab="preferences" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                        تنظیمات ظاهری
                    </button>
                    <button class="profile-nav-item" data-tab="notifications" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                        اعلان‌ها
                    </button>
                    <button class="profile-nav-item" data-tab="privacy" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                        حریم خصوصی
                    </button>
                </nav>

                <div class="profile-role-badge">
                    @if (Model.IsAdmin)
                    {
                        <span class="profile-role-tag profile-role-tag--admin">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8.5 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 9 8.5 12 2" /></svg>
                            مدیر سیستم
                        </span>
                    }
                    else
                    {
                        <span class="profile-role-tag profile-role-tag--user">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            کاربر عادی
                        </span>
                    }
                </div>
            </aside>

            <!-- Main content -->
            <main class="profile-main">

                <!-- OVERVIEW -->
                <section class="profile-tab is-active" data-tab="overview">
                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h2>به پنل شخصی خود خوش آمدید 👋</h2>
                            <p>اینجا می‌توانید همه چیز درباره حساب خود را ببینید و سفارشی کنید.</p>
                        </div>

                        <div class="profile-stats">
                            <div class="profile-stat">
                                <div class="profile-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5C21.0034 12.82 20.6951 14.12 20.1 15.3C19.3944 16.7118 18.3097 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0035 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92176 4.44061 8.37485 5.27072 7.03258C6.10083 5.69031 7.28825 4.6056 8.7 3.90003C9.87812 3.30496 11.1801 2.99659 12.5 3.00003H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" /></svg></div>
                                <div>
                                    <p class="profile-stat-num" data-count="0">۰</p>
                                    <p class="profile-stat-label">دیدگاه‌های شما</p>
                                </div>
                            </div>
                            <div class="profile-stat">
                                <div class="profile-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10V21H4C3.44772 21 3 20.5523 3 20V11C3 10.4477 3.44772 10 4 10H7ZM7 10L11.6923 3.3945C12.0735 2.85567 12.7963 2.68664 13.376 3.00227C14.5164 3.62194 15.1622 4.87275 14.9829 6.15626L14.5 9.6H18.9925C20.0684 9.6 20.9 10.5305 20.8055 11.6023L20.0949 19.6023C20.0104 20.5606 19.2077 21.3 18.2456 21.3H10C8.34315 21.3 7 19.9569 7 18.3V10Z" /></svg></div>
                                <div>
                                    <p class="profile-stat-num" data-count="0">۰</p>
                                    <p class="profile-stat-label">لایک‌های دریافتی</p>
                                </div>
                            </div>
                            <div class="profile-stat">
                                <div class="profile-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13V11C4 6.58172 7.58172 3 12 3C16.4183 3 20 6.58172 20 11V13" /><rect x="3" y="13" width="4" height="6" rx="1.5" /><rect x="17" y="13" width="4" height="6" rx="1.5" /></svg></div>
                                <div>
                                    <p class="profile-stat-num" data-count="0">۰</p>
                                    <p class="profile-stat-label">پاسخ‌های پشتیبانی</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h3>دسترسی سریع</h3>
                        </div>
                        <div class="profile-quick">
                            <button class="profile-quick-item" data-go="edit" type="button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                                <span>ویرایش نام</span>
                            </button>
                            <button class="profile-quick-item" data-go="security" type="button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                <span>تغییر رمز عبور</span>
                            </button>
                            <button class="profile-quick-item" data-go="preferences" type="button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 1v6M12 17v6M4.2 4.2l4.3 4.3M15.5 15.5l4.3 4.3M1 12h6M17 12h6M4.2 19.8l4.3-4.3M15.5 8.5l4.3-4.3" /></svg>
                                <span>سفارشی‌سازی ظاهر</span>
                            </button>
                            <button class="profile-quick-item" data-go="notifications" type="button">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                                <span>مدیریت اعلان‌ها</span>
                            </button>
                        </div>
                    </div>
                </section>

                <!-- EDIT PROFILE -->
                <section class="profile-tab" data-tab="edit">
                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h2>ویرایش اطلاعات حساب</h2>
                            <p>تغییرات شما پس از ذخیره اعمال خواهند شد.</p>
                        </div>

                        <form class="profile-form" id="profileEditForm" novalidate>
                            <div class="profile-avatar-edit">
                                <div class="profile-avatar profile-avatar--lg" id="profileAvatarBig">@Model.Initial</div>
                                <div class="profile-avatar-actions">
                                    <button type="button" class="btn btn-ghost" disabled>
                                        <svg viewBox="0 0 24 24" class="icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" /></svg>
                                        <span>تغییر تصویر (به‌زودی)</span>
                                    </button>
                                    <p class="profile-hint">پشتیبانی از تصویر پروفایل به‌زودی فعال خواهد شد.</p>
                                </div>
                            </div>

                            <div class="profile-form-grid">
                                <div class="profile-field">
                                    <label>نام</label>
                                    <input type="text" name="FirstName" value="@Model.FirstName" class="profile-input" required>
                                </div>
                                <div class="profile-field">
                                    <label>نام خانوادگی</label>
                                    <input type="text" name="LastName" value="@Model.LastName" class="profile-input">
                                </div>
                                <div class="profile-field profile-field--full">
                                    <label>شماره موبایل (غیرقابل تغییر)</label>
                                    <input type="text" name="PhoneNumber" value="@Model.Phone" class="profile-input" disabled>
                                </div>
                                <div class="profile-field profile-field--full">
                                    <label>بیوگرافی</label>
                                    <textarea name="Bio" class="profile-input profile-textarea" rows="3" placeholder="چند کلمه درباره خودتان بنویسید..."></textarea>
                                </div>
                                <div class="profile-field profile-field--full">
                                    <label>ایمیل (اختیاری)</label>
                                    <input type="email" name="Email" class="profile-input" placeholder="example@email.com">
                                </div>
                                <div class="profile-field">
                                    <label>شهر</label>
                                    <input type="text" name="City" class="profile-input" placeholder="مثلاً بهبهان">
                                </div>
                                <div class="profile-field">
                                    <label>تاریخ تولد</label>
                                    <input type="text" name="BirthDate" class="profile-input" placeholder="۱۳۸۰/۰۱/۰۱">
                                </div>
                            </div>

                            <div class="profile-form-actions">
                                <button type="reset" class="btn btn-ghost">انصراف</button>
                                <button type="button" class="btn btn-solid" disabled>
                                    <span>ذخیره تغییرات (به‌زودی)</span>
                                </button>
                            </div>
                            <p class="profile-hint profile-hint--block">بک‌اند این بخش بعداً اضافه خواهد شد.</p>
                        </form>
                    </div>
                </section>

                <!-- SECURITY -->
                <section class="profile-tab" data-tab="security">
                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h2>امنیت و رمز عبور</h2>
                            <p>برای حفظ امنیت حساب، رمز عبور قوی انتخاب کنید و مرتباً آن را تغییر دهید.</p>
                        </div>

                        <form class="profile-form">
                            <div class="profile-field">
                                <label>رمز عبور فعلی</label>
                                <input type="password" class="profile-input" placeholder="رمز فعلی را وارد کنید" autocomplete="current-password">
                            </div>
                            <div class="profile-row-2">
                                <div class="profile-field">
                                    <label>رمز عبور جدید</label>
                                    <input type="password" class="profile-input" placeholder="حداقل ۸ کاراکتر" autocomplete="new-password">
                                </div>
                                <div class="profile-field">
                                    <label>تکرار رمز جدید</label>
                                    <input type="password" class="profile-input" placeholder="رمز جدید را دوباره وارد کنید" autocomplete="new-password">
                                </div>
                            </div>

                            <div class="profile-form-actions">
                                <button type="button" class="btn btn-solid" disabled>
                                    <span>بروزرسانی رمز عبور (به‌زودی)</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h3>نشست‌های فعال</h3>
                            <p>این بخش در آینده نشست‌های فعال شما را نمایش می‌دهد.</p>
                        </div>
                        <div class="profile-sessions">
                            <div class="profile-session is-current">
                                <div class="profile-session-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg></div>
                                <div>
                                    <p class="profile-session-name">دستگاه فعلی</p>
                                    <p class="profile-session-meta">مرورگر شما — همین لحظه</p>
                                </div>
                                <span class="profile-session-tag">فعلی</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- PREFERENCES -->
                <section class="profile-tab" data-tab="preferences">
                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h2>تنظیمات ظاهری</h2>
                            <p>تجربه کاربری خود را به دلخواه سفارشی کنید.</p>
                        </div>

                        <div class="profile-pref-list">
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">تم سایت</p>
                                    <p class="profile-pref-desc">انتخاب بین تم تیره و روشن.</p>
                                </div>
                                <div class="profile-toggle-group" data-pref="theme">
                                    <button type="button" class="is-active" data-value="dark">تیره</button>
                                    <button type="button" data-value="light">روشن</button>
                                    <button type="button" data-value="auto">خودکار</button>
                                </div>
                            </div>

                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">رنگ تأکیدی</p>
                                    <p class="profile-pref-desc">رنگ اصلی المان‌های تعاملی.</p>
                                </div>
                                <div class="profile-color-grid" data-pref="accent">
                                    <button type="button" class="is-active" data-value="blue" style="--swatch:#4d8bff"></button>
                                    <button type="button" data-value="violet" style="--swatch:#8b5cf6"></button>
                                    <button type="button" data-value="pink" style="--swatch:#f472b6"></button>
                                    <button type="button" data-value="cyan" style="--swatch:#49b9ff"></button>
                                    <button type="button" data-value="green" style="--swatch:#34d399"></button>
                                    <button type="button" data-value="amber" style="--swatch:#fbbf24"></button>
                                </div>
                            </div>

                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">تراکم نمایش</p>
                                    <p class="profile-pref-desc">میزان فاصله بین المان‌ها.</p>
                                </div>
                                <div class="profile-toggle-group" data-pref="density">
                                    <button type="button" data-value="compact">فشرده</button>
                                    <button type="button" class="is-active" data-value="comfortable">راحت</button>
                                    <button type="button" data-value="spacious">باز</button>
                                </div>
                            </div>

                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">انیمیشن‌ها</p>
                                    <p class="profile-pref-desc">جلوه‌های حرکتی و گذارها.</p>
                                </div>
                                <label class="profile-switch">
                                    <input type="checkbox" checked>
                                    <span class="profile-switch-track"><span class="profile-switch-thumb"></span></span>
                                </label>
                            </div>
                        </div>

                        <p class="profile-hint profile-hint--block">این تنظیمات فقط ظاهر را تغییر می‌دهند و بعد از اتصال به بک‌اند ذخیره خواهند شد.</p>
                    </div>
                </section>

                <!-- NOTIFICATIONS -->
                <section class="profile-tab" data-tab="notifications">
                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h2>اعلان‌ها</h2>
                            <p>مشخص کنید چه رویدادهایی برایتان اعلان ارسال شود.</p>
                        </div>

                        <div class="profile-pref-list">
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">پاسخ جدید به دیدگاه‌هایم</p>
                                    <p class="profile-pref-desc">وقتی تیم پشتیبانی به دیدگاه شما پاسخ می‌دهد.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox" checked><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">خبرهای مهم</p>
                                    <p class="profile-pref-desc">اطلاع‌رسانی درباره خبرهای فوری و ضروری.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox" checked><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">پیشنهاد خدمات جدید</p>
                                    <p class="profile-pref-desc">از زمان اضافه شدن خدمات جدید باخبر شوید.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">ایمیل خلاصه هفتگی</p>
                                    <p class="profile-pref-desc">هر هفته یک ایمیل با مهم‌ترین خبرها.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">پیامک</p>
                                    <p class="profile-pref-desc">دریافت اعلان‌های حیاتی از طریق پیامک.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- PRIVACY -->
                <section class="profile-tab" data-tab="privacy">
                    <div class="profile-card glass-strong">
                        <div class="profile-card-head">
                            <h2>حریم خصوصی</h2>
                            <p>کنترل کنید اطلاعات شما چگونه نمایش داده شود.</p>
                        </div>

                        <div class="profile-pref-list">
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">نمایش نام در دیدگاه‌ها</p>
                                    <p class="profile-pref-desc">نام شما در کنار دیدگاه‌هایتان نمایش داده شود.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox" checked><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">نمایش عمومی پروفایل</p>
                                    <p class="profile-pref-desc">امکان مشاهده پروفایل برای دیگران.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                            <div class="profile-pref">
                                <div>
                                    <p class="profile-pref-name">شماره موبایل</p>
                                    <p class="profile-pref-desc">نمایش شماره موبایل در پروفایل عمومی.</p>
                                </div>
                                <label class="profile-switch"><input type="checkbox"><span class="profile-switch-track"><span class="profile-switch-thumb"></span></span></label>
                            </div>
                        </div>
                    </div>

                    <div class="profile-card glass-strong profile-card--danger">
                        <div class="profile-card-head">
                            <h3>حذف حساب</h3>
                            <p>این عملیات غیرقابل بازگشت است. تمام داده‌های شما برای همیشه حذف خواهند شد.</p>
                        </div>
                        <button type="button" class="btn btn-danger" disabled>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" /></svg>
                            <span>حذف حساب (به‌زودی)</span>
                        </button>
                    </div>
                </section>

            </main>
        </div>
    </section>
</div>

<script>
    (function () {
        "use strict";
        const root = document.querySelector('.profile-zone');
        if (!root) return;

        // Tabs
        const navItems = root.querySelectorAll('.profile-nav-item');
        const tabs = root.querySelectorAll('.profile-tab');
        const quickItems = root.querySelectorAll('[data-go]');

        function showTab(name) {
            navItems.forEach(n => n.classList.toggle('is-active', n.dataset.tab === name));
            tabs.forEach(t => t.classList.toggle('is-active', t.dataset.tab === name));
            try {
                const url = new URL(window.location.href);
                url.searchParams.set('tab', name);
                history.replaceState(null, '', url);
            } catch (e) { }
        }

        navItems.forEach(n => n.addEventListener('click', () => showTab(n.dataset.tab)));
        quickItems.forEach(q => q.addEventListener('click', () => showTab(q.dataset.go)));

        // Allow deep-linking via ?tab=
        try {
            const params = new URLSearchParams(window.location.search);
            const t = params.get('tab');
            if (t && root.querySelector('[data-tab="' + t + '"]')) showTab(t);
        } catch (e) { }

        // Toggle groups (preferences)
        root.querySelectorAll('.profile-toggle-group').forEach(group => {
            group.addEventListener('click', e => {
                const btn = e.target.closest('button');
                if (!btn) return;
                group.querySelectorAll('button').forEach(b => b.classList.remove('is-active'));
                btn.classList.add('is-active');
            });
        });

        // Color swatches
        root.querySelectorAll('.profile-color-grid').forEach(grid => {
            grid.addEventListener('click', e => {
                const btn = e.target.closest('button');
                if (!btn) return;
                grid.querySelectorAll('button').forEach(b => b.classList.remove('is-active'));
                btn.classList.add('is-active');
            });
        });
    })();
</script>
