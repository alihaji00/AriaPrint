@model IndexViewModel

<!-- ================= HERO ================= -->
<div class="hero-news-bg">
    <canvas class="starfield-canvas" data-count="40" data-colors="#49b9ff,#8fd8ff,#6fc3ff" data-avoid=".hero-video-wrap"></canvas>
    <div class="index-blur-bg">

        <section class="hero" id="home">
            <div class="container hero-inner">

                <div class="hero-text">
                    <a href="#services" class="hero-badge">
                        <span class="hero-badge-dot"></span>
                        ما را در اینستاگرام دنبال کنید
                        <svg class="icon"><use href="#i-chevron-left"></use></svg>
                    </a>
                    <div class="hero-Sentences">
                        <h1 class="hero-title">کافینت آریا</h1>
                        <p class="hero-subtitle">همیشه یک قدم جلوتر از شما</p>
                        <p class="hero-desc">ارائه انواع خدمات اینترنتی، ثبت نام پرداخت قبوض. پرداخت خدمات دانشجویی اطلاع رسانی جدیدترین اخبار با سرعت، دقت و اطمینان</p>
                    </div>
                    <div class="hero-buttons">
                        <a href="#news" class="btn btn-ghost"><span>مشاهده آخرین اخبار</span><svg class="icon"><use href="#i-chevron-left"></use></svg></a>
                        <a href="/SubmitRequest" class="btn btn-solid hero-btn-submit">
                            <span>ثبت درخواست</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-submit-icon"><path d="M7 17V7h10"></path><path d="M17 17 7 7"></path></svg>
                        </a>
                    </div>
                </div>

                <partial name="_Hero3dLogo"></partial>

            </div>
        </section>

        <!-- ================= NEWS ================= -->
        <section class="news-section theme-section" id="news">
            <div class="container News-Container">

                <div class="full-section">

                    <div class="section-head">
                        <p class="eyebrow on-dark">آخرین اخبار و اطلاعیه‌ها</p>
                        <h2 class="section-title on-dark">همیشه به‌روز باشید</h2>
                        <span class="section-body">اخبار به محض دریافت اطلاعیه به روز میشن، پس خیالتون راحت باشه</span>
                    </div>

                    <div class="more-news">
                        <a href="/AllNews" class="btn btn-ghost">
                            <span>مشاهده تمامی اخبار</span>
                            <svg class="icon">
                                <use href="#i-chevron-left">

                                </use>
                            </svg>
                        </a>
                    </div>

                </div>

                <div class="news-grid">

                    @{
                        var Newest3 = Model.News.OrderByDescending(n => n.Id).Take(3).ToArray();

                        foreach (var item in Newest3)
                        {
                            <partial name="_NewsCard" model="item" />
                        }
                    }

                </div>

            </div>
        </section>
    </div>
</div>

<!-- ================= SERVICES ================= -->
<section class="services-section theme-section" id="services">
    <div class="container">
        <div class="section-head">
            <p class="eyebrow">خدمات ما</p>
            <h2 class="section-title">هر آنچه نیاز دارید</h2>
        </div>

        <div class="services-grid">

            @foreach (var item in Model.Services)
            {
                <partial name="_ServicesCard" model="item" />
            }

        </div>
    </div>
</section>

<!-- ================= WHY US ================= -->
<section class="whyus-section theme-section" id="about">
    <div class="container">
        <div class="section-head">
            <h2 class="section-title">چرا کافینت آریا؟</h2>
        </div>

        <div class="whyus-body">
            <div class="whyus-features">

                @{
                    foreach (var item in Model.WhyUs)
                    {
                        <partial name="_WhyUsCard" model="item"></partial>
                    }
                }

            </div>

            <div class="whyus-image">
                <span class="ph ph-tone"><svg><use href="#ph-tone"></use></svg></span>
            </div>
        </div>
    </div>
</section>
