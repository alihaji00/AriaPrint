@model AllNewsViewModel

<div class="all-news">
    <canvas class="starfield-canvas" data-count="20" data-colors="#49b9ff,#8fd8ff,#6fc3ff"></canvas>
    <div class="all-news-div">
        @{
            var news = Model.News.Where(n => n.Id > 0).ToArray();

            foreach (var item in news)
            {
                <partial name="_NewsCard" model="item"></partial>
            }
        }
    </div>
</div>